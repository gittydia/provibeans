# Copy to .env.local and paste your Neon connection strings.
# .env.local is gitignored. Never commit the real values.

# Used by the application, `npm run db:migrate` and `npm run db:seed`.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require

# Used by the destructive suites (verify:inventory, verify:periods), which
# truncate every table. Point this at a SEPARATE Neon branch so they can never
# wipe the database the application runs on.
DATABASE_URL_VERIFY=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require